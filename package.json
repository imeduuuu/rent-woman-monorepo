{
  "name": "rwoman",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "prisma:generate": "node scripts/run-with-env.mjs corepack pnpm --filter @repo/db prisma generate",
    "prisma:migrate": "node scripts/run-with-env.mjs corepack pnpm --filter @repo/db prisma migrate dev",
    "prisma:seed": "node scripts/run-with-env.mjs corepack pnpm --filter @repo/db db:seed"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
